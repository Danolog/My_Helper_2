    },
    "AUTH_RATE_LIMIT_STORE": {
      "class": "var",
      "required": false,
      "note": "Brak zmiennej = memory. Dozwolone wyłącznie memory albo database; inna wartość (także pusta) zatrzymuje start."
    },
    "BETA_ALLOWED_OWNER_EMAILS": {
      "class": "var",
      "required": false,
      "note": "Beta na zaproszenie: e-maile właścicieli, którzy mogą założyć salon (po przecinku). Brak albo pusta = nikt nie założy salonu."
    },
    "BETA_ALLOW_UNVERIFIED_OWNER": {
      "class": "ci-only",
      "note": "Tylko serwer E2E w CI i lokalny dev bez poczty: konto z listy bety może założyć salon bez poczty na serwerze i bez potwierdzonego e-maila. Nigdy na hostingu (bramka lib/hosting ignoruje ją na Vercelu i Cloud Run)."
    },
