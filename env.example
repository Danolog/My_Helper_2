# Database
# Postgres connection string. Provide your own local credentials; do not commit a real value.
POSTGRES_URL=

# Authentication - Better Auth
# REQUIRED. Generate a fresh random value of at least 32 characters,
# e.g. `openssl rand -base64 32`. Never commit a real value to the repo.
BETTER_AUTH_SECRET=

# Google OAuth (Optional)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Integration via OpenRouter (Optional - Pro plan only)
# Get your API key from: https://openrouter.ai/settings/keys
# View available models at: https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL="anthropic/claude-sonnet-4-5-20250929"

# Twarde limity kosztow AI per salon (opcjonalne - rozsadne wartosci domyslne)
# Laczny miesieczny budzet AI w USD dla jednego salonu (domyslnie: 20)
AI_MONTHLY_BUDGET_USD=20
# Maksymalna liczba wygenerowanych obrazow/banerow miesiecznie (domyslnie: 100)
AI_MONTHLY_IMAGE_LIMIT=100

# Upstash Redis (opcjonalne - rozproszony rate limiting przez REST API)
# Gdy oba pola sa ustawione, liczniki rate limitu zyja w Redis (wspolne dla
# wszystkich instancji serverless). Gdy brak - fallback na limiter in-memory.
# Klucze znajdziesz w konsoli: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional - for vector search only
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# App URL (for production deployments)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admini platformy (dostep do /api/diagnostics) - e-maile ISTNIEJACYCH kont,
# po przecinku, bez rozrozniania wielkosci liter. Pusta = nikt.
# Uprawnien NIE daje user.role; wlasnosc salonu to salons.ownerId.
ADMIN_EMAILS=

# Beta na zaproszenie - e-maile wlascicieli, ktorzy moga zalozyc salon,
# po przecinku, bez rozrozniania wielkosci liter (spacje wokol adresow
# pomijane). Pusta albo brak zmiennej = NIKT nie zalozy salonu (takze w dev -
# bez wyjatku dla NODE_ENV). Lokalnie wpisz adres swojego konta testowego.
# Rejestracji klientow (portal klienta) lista nie dotyczy.
# Nie commituj prawdziwych adresow; na produkcji ustawiana w konfiguracji uslugi.
# Salon wymaga tez skonfigurowanej poczty (RESEND_API_KEY) i POTWIERDZONEGO
# e-maila konta: bez poczty bramka odmawia kazdemu.
BETA_ALLOWED_OWNER_EMAILS=
# Tylko lokalny dev bez poczty / E2E: "1" = konto z listy moze zalozyc salon
# bez poczty na serwerze i bez potwierdzonego e-maila (lista nadal wymagana).
# Ignorowana na Vercelu i Cloud Run.
BETA_ALLOW_UNVERIFIED_OWNER=

# File storage (optional - if app requires file uploads)
BLOB_READ_WRITE_TOKEN=

# Stripe (subscriptions + deposits)
# Get keys from: https://dashboard.stripe.com/apikeys
# Zadatki (deposits) ida przez Stripe Checkout (mode=payment) z metodami
# karta, BLIK i Przelewy24 (P24). BLIK/P24 wymagaja waluty PLN oraz wlaczenia
# tych metod w Dashboard: https://dashboard.stripe.com/settings/payment_methods
# Bez STRIPE_SECRET_KEY zadatki dzialaja w trybie symulacji dev (/api/deposits/confirm).
# STRIPE_WEBHOOK_SECRET jest wymagany w produkcji do potwierdzania platnosci
# (webhook: checkout.session.completed / expired + zdarzenia subskrypcji).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs for subscription plans
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# SMSAPI.pl (opcjonalne - wysylka SMS do klientow)
# Token OAuth wygenerujesz w panelu: https://ssl.smsapi.pl/webapp#/oauth/manage
# Bez tokenu SMS-y sa tylko symulowane (log w konsoli) - dev dziala bez zmian.
SMSAPI_TOKEN=
# Nazwa nadawcy zatwierdzona w panelu SMSAPI (domyslnie "Info")
SMSAPI_SENDER=

# Zaufane reverse proxy (opcjonalne) - CSV adresow IP lub zakresow CIDR,
# np. "203.0.113.10/32" (adres dokumentacyjny). Domyslnie pusta.
# Czytaja ja Better Auth (advanced.ipAddress.trustedProxies) i getClientIp
# (src/lib/trusted-proxies.ts): adres klienta = pierwszy wpis X-Forwarded-For
# od prawej, ktory NIE jest zaufanym proxy.
# Vercel / lokalnie: NIE ustawiac (na Vercelu adres klienta to x-real-ip).
# GCP za LB: dokladnie adres rownowaznika obciazenia (LB) jako /32.
# Ustawienie jest bezpieczne takze przy ingress `all` (adres run.app omija LB):
# front Cloud Run dopisuje do X-Forwarded-For adres polaczenia, wiec podrobiony
# wpis klienta zostaje po lewej i nie jest brany za adres klienta.
# NIGDY nie wpisujemy zakresow Google Front End ani innych zakresow Google.
# Odrzucane z ostrzezeniem: wpisy niepoprawne, zakresy zbyt szerokie
# (IPv4 < /16, prywatne/specjalne < /24, IPv6 < /32, ULA/link-local < /64)
# i IPv4-mapped CIDR (::ffff:a.b.c.d/N). Zmiana wymaga restartu.
TRUSTED_PROXIES=
