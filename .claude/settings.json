{
  "permissions": {
    "allow": [
      "Bash(pnpm test*)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(npx playwright test*)",
      "Bash(git diff*)",
      "Bash(git status)",
      "Bash(git push*)",
      "Bash(git commit*)",
      "Read(**)",
      "Write(src/**)",
      "Write(__tests__/**)",
      "Write(tests/**)"
    ],
    "deny": [
      "Bash(pnpm publish*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; pnpm exec prettier --write \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
